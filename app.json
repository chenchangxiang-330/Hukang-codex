{
  "expo": {
    "name": "护康 HuKang",
    "slug": "hukang",
    "version": "1.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.hukang.local",
      "versionCode": 14,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "允许护康扫描商品条形码和食品标签。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "expiry-reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "选择食品或药品包装照片，仅保存在本机。",
          "cameraPermission": "拍摄食品或药品包装，仅保存在本机。",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#f3faf8"
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store"
    ],
    "updates": {
      "enabled": false
    }
  }
}
